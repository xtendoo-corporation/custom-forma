<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="external_layout_folder_inherit" inherit_id="web.external_layout_folder">

        <xpath expr="//div[contains(@t-attf-class, 'header o_company_')]" position="replace">
            <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">

                <div class="o_folder_header_container position-absolute start-0 top-0 z-n1 w-100">
                    <svg width="100%" height="174" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <rect width="100%" height="174"/>
                    </svg>
                    <div class="o_folder_adaptative_shape d-flex flex-start position-relative">
                        <svg class="d-block flex-grow-1" fill="none" height="100%" xmlns="http://www.w3.org/2000/svg">
                            <rect width="100%" height="100%"/>
                        </svg>
                        <svg class="o_folder_angle_shape" width="80" height="100%" viewBox="0 0 80 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5.70364 48H0V0.00100806H73.5404L80 0C74.2028 0.665869 68.7417 3.06684 64.332 6.88852L25.3513 40.6709C19.8969 45.3979 12.9212 48 5.70364 48Z"/>
                        </svg>
                        <div class="w-25"></div>
                    </div>
                </div>

                <div class="o_folder_company_info" style="padding-top: 10px;">
                    <div class="row">

                        <div class="col-7">
                            <img t-if="company.logo" class="o_company_logo_big mb-2"
                                 t-att-src="image_data_uri(company.logo)" alt="Logo"
                                 style="max-height: 50px;"/>

                            <div class="text-start" style="font-size: 0.9em;">
                                <t t-if="company.is_company_details_empty">
                                    <span t-field="company.partner_id"
                                        t-options='{"widget": "contact", "fields": ["address", "name", "vat"], "no_marker": true}'/>
                                </t>
                                <t t-else="">
                                    <span t-field="company.company_details"/>
                                </t>
                            </div>
                        </div>

                        <div class="col-5 text-end">
                            <h2 class="mt-2 text-nowrap" style="font-weight: bold; color: #444;">
                                <t t-if="layout_document_title" t-out="layout_document_title"/>
                                <t t-else="" t-out="o.name"/>
                            </h2>
                            <div t-if="company.report_header" t-field="company.report_header" class="o_company_tagline fw-bold text-muted"/>
                        </div>

                    </div>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[contains(@t-attf-class, 'article')]//h3" position="replace">
            <t/>
        </xpath>

    </template>
</odoo>
