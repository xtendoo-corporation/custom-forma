<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template para presupuesto sin totales -->
        <template id="report_saleorder_document_no_totals" inherit_id="sale.report_saleorder_document">
            <!-- Ocultar la sección completa de totales -->
            <xpath expr="//div[@name='so_total_summary']" position="replace">
                <!-- Sección de totales removida completamente -->
            </xpath>
        </template>

        <!-- Definir el reporte como acción -->
        <record id="action_report_saleorder_no_totals" model="ir.actions.report">
            <field name="name">Presupuesto sin totales</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">forma_document_format.report_saleorder_no_totals</field>
            <field name="report_file">forma_document_format.report_saleorder_no_totals</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Template principal del reporte -->
        <template id="report_saleorder_no_totals">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="forma_document_format.report_saleorder_document_no_totals" t-lang="doc.partner_id.lang"/>
                </t>
            </t>
        </template>
    </data>
</odoo>
