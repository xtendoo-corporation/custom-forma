<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_inherit_forma"
        inherit_id="stock.report_delivery_document">
        <xpath expr="//h2/span[2]" position="replace">
        </xpath>

        <xpath expr="//div[@name='outgoing_delivery_address']/strong" position="replace">
        </xpath>

        <xpath expr="//div[@name='div_sched_date']/div[@t-if=&quot;o.state == 'done'&quot;]"
            position="attributes">
            <attribute name="t-options">{"widget": "date"}</attribute>
        </xpath>
        <xpath expr="//div[@name='div_sched_date']/div[@t-else='']" position="attributes">
            <attribute name="t-options">{"widget": "date"}</attribute>
        </xpath>

        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']"
            position="after">
            <th name="th_sm_price_unit" class="text-end">
                <strong>Precio Unitario</strong>
            </th>
            <th name="th_sm_total" class="text-end">
                <strong>Total</strong>
            </th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody//tr/td[last()]" position="after">
            <td class="text-end">
                <span t-field="move.sale_line_id.price_unit"
                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}' />
            </td>
            <td class="text-end">
                <span t-esc="move.quantity * move.sale_line_id.price_unit"
                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}' />
            </td>
        </xpath>

        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']"
            position="after">
            <th name="th_sml_price_unit" class="text-end">
                <strong>Precio Unitario</strong>
            </th>
            <th name="th_sml_total" class="text-end">
                <strong>Total</strong>
            </th>
        </xpath>
    </template>

    <template id="report_delivery_document_inherit_sale_stock_forma"
        inherit_id="sale_stock.report_delivery_document_inherit_sale_stock">
        <xpath expr="//div[@t-if='o.sudo().sale_id.client_order_ref']/strong" position="replace">
            <strong>Referencia</strong>
        </xpath>
    </template>

    <template id="stock_report_delivery_has_serial_move_line_inherit_forma"
        inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[@name='move_line_lot_quantity']" position="after">
            <td class="text-end">
                <span t-field="move_line.move_id.sale_line_id.price_unit"
                    t-options='{"widget": "monetary", "display_currency": move_line.company_id.currency_id}' />
            </td>
            <td class="text-end">
                <span t-esc="move_line.quantity * move_line.move_id.sale_line_id.price_unit"
                    t-options='{"widget": "monetary", "display_currency": move_line.company_id.currency_id}' />
            </td>
        </xpath>
    </template>

    <template id="stock_report_delivery_aggregated_move_lines_inherit_forma"
        inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="after">
            <td class="text-end">
                <span
                    t-esc="aggregated_lines[line]['move'].sale_line_id.price_unit if aggregated_lines[line].get('move') else 0"
                    t-options='{"widget": "monetary", "display_currency": aggregated_lines[line]["move"].company_id.currency_id if aggregated_lines[line].get("move") else None}' />
            </td>
            <td class="text-end">
                <span
                    t-esc="aggregated_lines[line]['quantity'] * aggregated_lines[line]['move'].sale_line_id.price_unit if aggregated_lines[line].get('move') else 0"
                    t-options='{"widget": "monetary", "display_currency": aggregated_lines[line]["move"].company_id.currency_id if aggregated_lines[line].get("move") else None}' />
            </td>
        </xpath>
    </template>

</odoo>