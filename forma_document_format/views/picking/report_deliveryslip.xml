<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_inherit_forma"
        inherit_id="stock.report_delivery_document"
        priority="18">
        <xpath expr="//h2" position="attributes">
            <attribute name="style">margin-bottom: 14px; color: #0b5394;</attribute>
        </xpath>

        <xpath expr="//table[@name='stock_move_table']" position="attributes">
            <attribute name="style">margin-top: 10px; width: 100%;</attribute>
        </xpath>

        <xpath expr="//table[@name='stock_move_table']/thead/tr" position="replace">
            <tr>
                <th name="th_sm_product"><strong>Producto</strong></th>
                <th name="th_sm_price_unit" class="text-end" t-if="o.partner_id.valued_picking">
                    <strong>Precio</strong>
                </th>
                <th name="th_sm_total" class="text-end" t-if="o.partner_id.valued_picking">
                    <strong>Total</strong>
                </th>
            </tr>
        </xpath>

        <xpath expr="//table[@name='stock_move_table']/tbody//tr/td[contains(@class, 'o_td_quantity')][1]" position="replace"/>

        <xpath expr="//table[@name='stock_move_table']/tbody//tr/td[last()]" position="replace">
            <td class="text-end" t-if="o.partner_id.valued_picking">
                <t t-if="move.sale_line_id">
                    <span t-field="move.sale_line_id.price_unit"
                        t-options='{"widget": "monetary", "display_currency": o.sudo().sale_id.currency_id or move.company_id.currency_id}'/>
                </t>
            </td>
            <td class="text-end" t-if="o.partner_id.valued_picking">
                <t t-if="move.sale_line_id">
                    <span t-field="move.sale_line_id.price_total"
                        t-options='{"widget": "monetary", "display_currency": o.sudo().sale_id.currency_id or move.company_id.currency_id}'/>
                </t>
            </td>
        </xpath>

        <xpath expr="//table[@name='stock_move_line_table']" position="attributes">
            <attribute name="style">margin-top: 10px; width: 100%;</attribute>
        </xpath>

        <xpath expr="//table[@name='stock_move_line_table']/thead/tr" position="replace">
            <tr>
                <th name="th_sml_product">Producto</th>
                <th name="th_sml_package" t-if="has_multi_level_packages">Paquete</th>
                <th name="lot_serial" class="text-end" t-if="has_serial_number">
                    Lote/N. serie
                </th>
                <th name="th_sml_price_unit" class="text-end" t-if="o.partner_id.valued_picking">
                    <strong>Precio</strong>
                </th>
                <th name="th_sml_total" class="text-end" t-if="o.partner_id.valued_picking">
                    <strong>Total</strong>
                </th>
            </tr>
        </xpath>


        <xpath expr="//h2/span[2]" position="replace">
        </xpath>

        <xpath expr="//div[@name='outgoing_delivery_address']" position="replace"/>

        <xpath expr="//div[@name='outgoing_warehouse_address']" position="replace"/>

        <xpath expr="//div[@name='div_incoming_address']" position="replace">
            <div class="col-auto" name="div_incoming_address" style="white-space: nowrap;">
                <t t-if="o.picking_type_id.code == 'outgoing' and partner">
                    <div t-field="partner.commercial_partner_id"
                         t-options='{"widget": "contact", "fields": ["name", "address", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
                </t>
                <t t-elif="o.picking_type_id.code == 'incoming' and partner">
                    <div t-field="partner.commercial_partner_id"
                         t-options='{"widget": "contact", "fields": ["name", "address", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
                </t>
            </div>
        </xpath>

        <xpath expr="//div[@name='div_sched_date']/div[@t-if=&quot;o.state == 'done'&quot;]"
            position="attributes">
            <attribute name="t-options">{"widget": "date"}</attribute>
        </xpath>
        <xpath expr="//div[@name='div_sched_date']/div[@t-else='']" position="attributes">
            <attribute name="t-options">{"widget": "date"}</attribute>
        </xpath>

    </template>

    <template id="report_delivery_document_inherit_sale_stock_forma"
        inherit_id="sale_stock.report_delivery_document_inherit_sale_stock">
        <xpath expr="//div[@t-if='o.sudo().sale_id.client_order_ref']/strong" position="replace">
            <strong>Referencia</strong>
        </xpath>
    </template>

    <!-- Líneas con número de serie (stock_move_line_table detallada) -->
    <template id="stock_report_delivery_has_serial_move_line_inherit_forma"
        inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[@name='move_line_lot_quantity']" position="replace">
            <td class="text-end" t-if="move_line.picking_id.partner_id.valued_picking">
                <t t-if="move_line.move_id.sale_line_id">
                    <span t-field="move_line.move_id.sale_line_id.price_unit"
                        t-options='{"widget": "monetary", "display_currency": move_line.picking_id.sudo().sale_id.currency_id or move_line.company_id.currency_id}'/>
                </t>
            </td>
            <td class="text-end" t-if="move_line.picking_id.partner_id.valued_picking">
                <t t-if="move_line.move_id.sale_line_id">
                    <span t-field="move_line.move_id.sale_line_id.price_total"
                        t-options='{"widget": "monetary", "display_currency": move_line.picking_id.sudo().sale_id.currency_id or move_line.company_id.currency_id}'/>
                </t>
            </td>
        </xpath>
    </template>

    <!-- Líneas agrupadas (stock_move_line_table sin serie) -->
    <template id="stock_report_delivery_aggregated_move_lines_inherit_forma"
        inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[@name='move_line_aggregated_qty_ordered']" position="replace"/>

        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="replace">
            <td class="text-end" t-if="o.partner_id.valued_picking">
                <t t-if="aggregated_lines[line].get('move') and aggregated_lines[line]['move'].sale_line_id">
                    <span t-field="aggregated_lines[line]['move'].sale_line_id.price_unit"
                        t-options='{"widget": "monetary", "display_currency": o.sudo().sale_id.currency_id or o.company_id.currency_id}'/>
                </t>
            </td>
            <td class="text-end" t-if="o.partner_id.valued_picking">
                <t t-if="aggregated_lines[line].get('move') and aggregated_lines[line]['move'].sale_line_id">
                    <span t-field="aggregated_lines[line]['move'].sale_line_id.price_total"
                        t-options='{"widget": "monetary", "display_currency": o.sudo().sale_id.currency_id or o.company_id.currency_id}'/>
                </t>
            </td>
        </xpath>
    </template>

    <template id="valued_report_picking_align_left_forma"
        inherit_id="stock_picking_report_valued.valued_report_picking">
        <xpath expr="//table[hasclass('table-borderless') and hasclass('mt32')]" position="replace">
            <t t-if="o.valued and o.sale_id and o.move_line_ids and is_outgoing">
                <table class="table table-borderless mt32" style="width: 50%; margin-left: auto;">
                    <tbody>
                        <tr>
                            <td><strong>Base imponible</strong></td>
                            <td class="text-end" style="white-space: nowrap;"><span t-field="o.amount_untaxed"/></td>
                        </tr>
                        <tr>
                            <td><strong>IVA 21%: </strong></td>
                            <td class="text-end" style="white-space: nowrap;"><span t-field="o.amount_tax"/></td>
                        </tr>
                        <tr>
                            <td><strong>Total</strong></td>
                            <td class="text-end" style="white-space: nowrap;"><span t-field="o.amount_total"/></td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </xpath>
    </template>
</odoo>
